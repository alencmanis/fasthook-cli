  },
  "components": {
    "securitySchemes": {
      "SessionBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Dashboard session bearer token. Project API keys cannot manage project API keys."
      },
      "ProjectApiKeyBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "fhp_*",
        "description": "Project API key. Only operations declaring this security scheme accept it, subject to scopes and exact execute grants."
      }
    },
    "parameters": {
      "TeamId": {
        "name": "x-team-id",
        "in": "header",
        "required": false,
        "description": "Team selected for the operation. The session must belong to that team's owner or a site admin.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "ProjectApiKeyId": {
        "type": "string",
        "pattern": "^pak_(?:[0-9a-f]{32}|legacy_[0-9a-f]{32})$"
      },
      "ProjectApiKeyScope": {
        "type": "string",
        "enum": [
          "control:read",
          "control:execute",
          "tunnel:connect"
        ]
      },
      "ProjectApiKeyExecuteGrant": {
        "type": "string",
        "enum": [
          "POST:/v1/sources/:id/run",
          "POST:/v1/sources/:id/channel-retry",
          "PUT:/v1/transformations/validate",
          "PUT:/v1/transformations/run",
          "POST:/v1/filters/test",
          "POST:/v1/requests/bulk_operations",
          "POST:/v1/requests/:id/retry",
          "POST:/v1/events/bulk_operations",
          "POST:/v1/events/:id/retry",
          "POST:/v1/request-fixtures/:id/replay",
          "POST:/v1/workflows/:id/runs/:executionId/retry"
        ]
      },
      "ProjectApiKeyStatus": {
        "type": "string",
        "enum": [
          "active",
          "disabled",
          "revoked"
        ]
      },
      "MutableProjectApiKeyStatus": {
        "type": "string",
        "enum": [
          "active",
          "disabled"
        ]
      },
      "ProjectApiKey": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "team_id",
          "name",
          "masked_key",
          "status",
          "scopes",
          "execute_grants",
          "rate_limit_per_minute",
          "legacy_project_secret",
          "created_by_user_id",
          "last_used_at",
          "secret_last_rotated_at",
          "revoked_at",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ProjectApiKeyId"
          },
          "team_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "masked_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "$ref": "#/components/schemas/ProjectApiKeyStatus"
          },
          "scopes": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 3,
            "items": {
              "$ref": "#/components/schemas/ProjectApiKeyScope"
            }
          },
          "execute_grants": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 11,
            "items": {
              "$ref": "#/components/schemas/ProjectApiKeyExecuteGrant"
            }
          },
          "rate_limit_per_minute": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "legacy_project_secret": {
            "type": "boolean"
          },
          "created_by_user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "last_used_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "secret_last_rotated_at": {
            "type": "string",
            "format": "date-time"
          },
          "revoked_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProjectApiKeyWithSecret": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "team_id",
          "name",
          "masked_key",
          "status",
          "scopes",
          "execute_grants",
          "rate_limit_per_minute",
          "legacy_project_secret",
          "created_by_user_id",
          "last_used_at",
          "secret_last_rotated_at",
          "revoked_at",
          "created_at",
          "updated_at",
          "api_key"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/ProjectApiKeyId"
          },
          "team_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "masked_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "status": {
            "$ref": "#/components/schemas/ProjectApiKeyStatus"
          },
          "scopes": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 3,
            "items": {
              "$ref": "#/components/schemas/ProjectApiKeyScope"
            }
          },
          "execute_grants": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 11,
            "items": {
              "$ref": "#/components/schemas/ProjectApiKeyExecuteGrant"
            }
          },
          "rate_limit_per_minute": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
