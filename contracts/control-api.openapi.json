      "put": {
        "operationId": "replaceProjectApiKey",
        "summary": "Update a project API key using PUT",
        "description": "Uses the same partial-update semantics as PATCH; omitted fields retain their current values.",
        "tags": [
          "Project API keys"
        ],
        "security": [
          {
            "SessionBearer": []
          }
        ],
        "x-fasthook-required-role": "team_owner_or_site_admin",
        "parameters": [
          {
            "$ref": "#/components/parameters/TeamId"
          },
          {
            "name": "keyId",
            "in": "path",
            "required": true,
            "description": "Stable pak_* key identifier.",
            "schema": {
              "$ref": "#/components/schemas/ProjectApiKeyId"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProjectApiKeyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated project API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectApiKeyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid key policy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "A project owner or site-admin session is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Key not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Revoked key or gated legacy policy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteProjectApiKey",
        "summary": "Permanently revoke a project API key",
        "description": "DELETE is an idempotent permanent revocation and returns the resulting key metadata.",
        "tags": [
          "Project API keys"
        ],
        "security": [
          {
            "SessionBearer": []
          }
        ],
        "x-fasthook-required-role": "team_owner_or_site_admin",
        "parameters": [
          {
            "$ref": "#/components/parameters/TeamId"
          },
          {
            "name": "keyId",
            "in": "path",
            "required": true,
            "description": "Stable pak_* key identifier.",
            "schema": {
              "$ref": "#/components/schemas/ProjectApiKeyId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Revoked project API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectApiKeyResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "A project owner or site-admin session is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Key not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Legacy policy cutover is not complete",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/project-api-keys/{keyId}/revoke": {
      "post": {
        "operationId": "revokeProjectApiKey",
        "summary": "Permanently revoke a project API key",
        "description": "Explicit revocation alias for clients that do not use DELETE.",
        "tags": [
          "Project API keys"
        ],
        "security": [
          {
            "SessionBearer": []
          }
        ],
        "x-fasthook-required-role": "team_owner_or_site_admin",
        "parameters": [
          {
            "$ref": "#/components/parameters/TeamId"
          },
          {
            "name": "keyId",
            "in": "path",
            "required": true,
            "description": "Stable pak_* key identifier.",
            "schema": {
              "$ref": "#/components/schemas/ProjectApiKeyId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Revoked project API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectApiKeyResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "A project owner or site-admin session is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Key not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Legacy policy cutover is not complete",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/project-api-keys/{keyId}/audit": {
      "get": {
        "operationId": "listProjectApiKeyAudit",
        "summary": "List project API key audit decisions",
        "description": "Returns at most 100 coalesced audit decisions for the selected key.",
        "tags": [
          "Project API keys"
        ],
        "security": [
          {
            "SessionBearer": []
          }
        ],
        "x-fasthook-required-role": "team_owner_or_site_admin",
        "parameters": [
          {
            "$ref": "#/components/parameters/TeamId"
          },
          {
            "name": "keyId",
            "in": "path",
            "required": true,
            "description": "Stable pak_* key identifier.",
            "schema": {
              "$ref": "#/components/schemas/ProjectApiKeyId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Project API key audit entries",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectApiKeyAuditListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "A project owner or site-admin session is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/filters/test": {
      "post": {
        "operationId": "testFilter",
        "summary": "Test filter conditions",
        "description": "Evaluates filter conditions against a supplied request envelope without storing either value.",
        "tags": [
          "Filters"
        ],
        "security": [
          {
            "SessionBearer": []
          },
          {
            "ProjectApiKeyBearer": []
          }
        ],
        "x-fasthook-required-role": "team_member_or_site_admin_or_project_api_key_execute",
        "parameters": [
          {
            "$ref": "#/components/parameters/TeamId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FilterTestRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Filter evaluation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FilterTestResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or empty filter conditions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Execute permission or the exact project-key grant is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
