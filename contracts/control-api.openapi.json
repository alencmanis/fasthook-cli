{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "FastHook Control API — Partial contract",
    "version": "0.2.0",
    "description": "A deliberately partial contract for stable FastHook Control API surfaces. It does not claim coverage of the complete Control API."
  },
  "servers": [
    {
      "url": "https://api.fasthook.io"
    }
  ],
  "tags": [
    {
      "name": "Project API keys"
    },
    {
      "name": "Filters"
    }
  ],
  "x-fasthook-contract-coverage": {
    "status": "partial",
    "surfaces": [
      "project-api-keys",
      "filter-test"
    ],
    "sourceFiles": [
      "src/control-api.ts",
      "src/control-api-authorization.ts",
      "src/control-api-filters.ts",
      "src/filter-rule.ts",
      "src/project-api-keys.ts"
    ],
    "excluded": [
      "All Control API resources other than project-api-keys and POST /v1/filters/test",
      "Dashboard proxy paths under /api/control",
      "CLI commands and widget runtime surfaces; synchronized artifacts do not imply owner-session feature support",
      "The hand-authored public documentation OpenAPI document"
    ]
  },
  "paths": {
    "/v1/project-api-keys": {
      "get": {
        "operationId": "listProjectApiKeys",
        "summary": "List project API keys",
        "description": "Returns at most 100 keys for the selected team without raw credentials or hashes.",
        "tags": [
          "Project API keys"
        ],
        "security": [
          {
            "SessionBearer": []
          }
        ],
        "x-fasthook-required-role": "team_owner_or_site_admin",
        "parameters": [
          {
            "$ref": "#/components/parameters/TeamId"
          }
        ],
        "responses": {
          "200": {
            "description": "Project API keys",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectApiKeyListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "A project owner or site-admin session is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createProjectApiKey",
        "summary": "Create a project API key",
        "description": "Creates a key and returns its raw credential exactly once with Cache-Control: no-store.",
        "tags": [
          "Project API keys"
        ],
        "security": [
          {
            "SessionBearer": []
          }
        ],
        "x-fasthook-required-role": "team_owner_or_site_admin",
        "parameters": [
          {
            "$ref": "#/components/parameters/TeamId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProjectApiKeyRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created key and one-time credential",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateProjectApiKeyResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid key policy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "A project owner or site-admin session is required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "The non-revoked key limit was reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
