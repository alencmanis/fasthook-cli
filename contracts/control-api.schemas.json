{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.fasthook.io/contracts/control-api/project-api-keys.schema.json",
  "title": "FastHook Control API — Project API keys",
  "description": "A deliberately partial contract for the stable project API key management surface. It does not claim coverage of the complete FastHook Control API.",
  "$comment": "Coverage: partial; surface: project-api-keys.",
  "$defs": {
    "ProjectApiKeyId": {
      "type": "string",
      "pattern": "^pak_(?:[0-9a-f]{32}|legacy_[0-9a-f]{32})$"
    },
    "ProjectApiKeyScope": {
      "type": "string",
      "enum": [
        "control:read",
        "control:execute",
        "tunnel:connect"
      ]
    },
    "ProjectApiKeyExecuteGrant": {
      "type": "string",
      "enum": [
        "POST:/v1/sources/:id/run",
        "POST:/v1/sources/:id/channel-retry",
        "PUT:/v1/transformations/validate",
        "PUT:/v1/transformations/run",
        "POST:/v1/filters/test",
        "POST:/v1/requests/bulk_operations",
        "POST:/v1/requests/:id/retry",
        "POST:/v1/events/bulk_operations",
        "POST:/v1/events/:id/retry",
        "POST:/v1/request-fixtures/:id/replay",
        "POST:/v1/workflows/:id/runs/:executionId/retry"
      ]
    },
    "ProjectApiKeyStatus": {
      "type": "string",
      "enum": [
        "active",
        "disabled",
        "revoked"
      ]
    },
    "MutableProjectApiKeyStatus": {
      "type": "string",
      "enum": [
        "active",
        "disabled"
      ]
    },
    "ProjectApiKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "team_id",
        "name",
        "masked_key",
        "status",
        "scopes",
        "execute_grants",
        "rate_limit_per_minute",
        "legacy_project_secret",
        "created_by_user_id",
        "last_used_at",
        "secret_last_rotated_at",
        "revoked_at",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ProjectApiKeyId"
        },
        "team_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "masked_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "$ref": "#/$defs/ProjectApiKeyStatus"
        },
        "scopes": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/ProjectApiKeyScope"
          }
        },
        "execute_grants": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 11,
          "items": {
            "$ref": "#/$defs/ProjectApiKeyExecuteGrant"
          }
        },
        "rate_limit_per_minute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "legacy_project_secret": {
          "type": "boolean"
        },
        "created_by_user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_used_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "secret_last_rotated_at": {
          "type": "string",
          "format": "date-time"
        },
        "revoked_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ProjectApiKeyWithSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "team_id",
        "name",
        "masked_key",
        "status",
        "scopes",
        "execute_grants",
        "rate_limit_per_minute",
        "legacy_project_secret",
        "created_by_user_id",
        "last_used_at",
        "secret_last_rotated_at",
        "revoked_at",
        "created_at",
        "updated_at",
        "api_key"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ProjectApiKeyId"
        },
        "team_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "masked_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "$ref": "#/$defs/ProjectApiKeyStatus"
        },
        "scopes": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/ProjectApiKeyScope"
          }
        },
        "execute_grants": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 11,
          "items": {
            "$ref": "#/$defs/ProjectApiKeyExecuteGrant"
          }
        },
        "rate_limit_per_minute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "legacy_project_secret": {
          "type": "boolean"
        },
        "created_by_user_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_used_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "secret_last_rotated_at": {
          "type": "string",
          "format": "date-time"
        },
        "revoked_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "api_key": {
          "type": "string",
          "pattern": "^fhp_[0-9a-f]{64}$",
          "description": "Returned only by createProjectApiKey. Store it immediately; it cannot be retrieved later."
        }
      }
    },
    "ProjectApiKeyResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/ProjectApiKey"
        }
      }
    },
    "CreateProjectApiKeyResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "$ref": "#/$defs/ProjectApiKeyWithSecret"
        }
      }
    },
    "ProjectApiKeyListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/ProjectApiKey"
          }
        }
      }
    },
    "CreateProjectApiKeyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "scopes"
      ],
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "execute_grants"
            ],
            "properties": {
              "execute_grants": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "then": {
            "type": "object",
            "properties": {
              "scopes": {
                "type": "array",
                "contains": {
                  "const": "control:execute"
                }
              }
            }
          }
        }
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "\\S"
        },
        "scopes": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/ProjectApiKeyScope"
          }
        },
        "execute_grants": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 11,
          "items": {
            "$ref": "#/$defs/ProjectApiKeyExecuteGrant"
          }
        },
        "rate_limit_per_minute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "UpdateProjectApiKeyRequest": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "execute_grants"
            ],
            "properties": {
              "execute_grants": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "then": {
            "type": "object",
            "anyOf": [
              {
                "type": "object",
                "not": {
                  "type": "object",
                  "required": [
                    "scopes"
                  ],
                  "properties": {
                    "scopes": {}
                  }
                }
              },
              {
                "type": "object",
                "properties": {
                  "scopes": {
                    "type": "array",
                    "contains": {
                      "const": "control:execute"
                    }
                  }
                }
              }
            ]
          }
        }
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "\\S"
        },
        "status": {
          "$ref": "#/$defs/MutableProjectApiKeyStatus"
        },
        "scopes": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/ProjectApiKeyScope"
          }
        },
        "execute_grants": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 11,
          "items": {
            "$ref": "#/$defs/ProjectApiKeyExecuteGrant"
          }
        },
        "rate_limit_per_minute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "ProjectApiKeyAuditDecision": {
      "type": "string",
      "enum": [
        "allowed",
        "denied",
        "rate_limited"
      ]
    },
    "ProjectApiKeyAuditEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "key_id",
        "team_id",
        "route_key",
        "permission",
        "decision",
        "reason",
        "cf_ray",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "key_id": {
          "$ref": "#/$defs/ProjectApiKeyId"
        },
        "team_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "route_key": {
          "type": "string",
          "maxLength": 96
        },
        "permission": {
          "type": "string",
          "enum": [
            "read",
            "edit",
            "rotate-secret",
            "execute",
            "tunnel-connect"
          ]
        },
        "decision": {
          "$ref": "#/$defs/ProjectApiKeyAuditDecision"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64
            },
            {
              "type": "null"
            }
          ]
        },
        "cf_ray": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ProjectApiKeyAuditListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data"
      ],
      "properties": {
        "data": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/ProjectApiKeyAuditEntry"
          }
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
